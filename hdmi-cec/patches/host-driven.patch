+#ifndef CEC_COMMAND_H
+#define CEC_COMMAND_H
+#include <stdbool.h>
+#include <stdint.h>
+
+typedef enum {
+  CEC_COMMAND_ON,
+  CEC_COMMAND_OFF,
+  CEC_COMMAND_INPUT,
+} cec_command_kind_t;
+
+typedef enum {
+  CEC_COMMAND_IDLE,
+  CEC_COMMAND_QUEUED,
+  CEC_COMMAND_PENDING,
+  CEC_COMMAND_DONE,
+} cec_command_state_t;
+
+typedef enum {
+  CEC_COMMAND_ACK,
+  CEC_COMMAND_NACK,
+  CEC_COMMAND_BUSY,
+  CEC_COMMAND_TIMEOUT,
+  CEC_COMMAND_COLLISION,
+  CEC_COMMAND_ERROR,
+} cec_command_result_t;
+
+typedef struct {
+  uint8_t data[4];
+  uint8_t len;
+} cec_command_frame_t;
+
+typedef struct {
+  uint32_t id;
+  cec_command_kind_t kind;
+  uint16_t physical_address;
+  cec_command_state_t state;
+  cec_command_result_t result;
+} cec_command_status_t;
+
+bool cec_command_valid_physical_address(uint16_t address);
+bool cec_command_encode(cec_command_kind_t kind, uint16_t address, cec_command_frame_t *frame);
+bool cec_command_submit(uint32_t id, cec_command_kind_t kind, uint16_t address);
+bool cec_command_snapshot(uint32_t id, cec_command_status_t *out);
+const char *cec_command_state_name(cec_command_state_t state);
+const char *cec_command_result_name(cec_command_result_t result);
+#endif
