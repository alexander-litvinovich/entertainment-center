+static int exec_cec(void *arg, int argc, const char **argv) {
+  (void)arg;
+  uint32_t id;
+  if (argc == 2 && strcmp(argv[1], "line") == 0) {
+    // Diagnostic: sample the CEC line for 200 ms.
+    unsigned high = 0, edges = 0;
+    bool previous = cec_frame_line_high();
+    for (int i = 0; i < 2000; ++i) {
+      bool level = cec_frame_line_high();
+      high += level;
+      edges += level != previous;
+      previous = level;
+      busy_wait_us(100);
+    }
+    cdc_printfln("@cec line high=%u/2000 edges=%u", high, edges);
+    return 0;
+  }
+  if (argc == 3 && strcmp(argv[1], "status") == 0 && parse_request_id(argv[2], &id)) {
+    cec_command_status_t status;
+    if (!cec_command_snapshot(id, &status)) {
+      cdc_printfln("@cec id=%lu state=rejected result=error", (unsigned long)id);
+      return 0;
+    }
+    if (status.state == CEC_COMMAND_DONE) {
+      cdc_printfln("@cec id=%lu state=done result=%s", (unsigned long)id,
+                   cec_command_result_name(status.result));
+    } else {
+      cdc_printfln("@cec id=%lu state=%s", (unsigned long)id,
+                   cec_command_state_name(status.state));
+    }
+    return 0;
+  }
+
+  if (argc >= 4 && strcmp(argv[1], "submit") == 0 && parse_request_id(argv[2], &id)) {
+    cec_command_kind_t kind = CEC_COMMAND_ON;
+    uint16_t address = 0;
+    bool valid = false;
+    if (argc == 4 && strcmp(argv[3], "on") == 0) {
+      kind = CEC_COMMAND_ON;
+      valid = true;
+    } else if (argc == 4 && strcmp(argv[3], "off") == 0) {
+      kind = CEC_COMMAND_OFF;
+      valid = true;
+    } else if (argc == 5 && strcmp(argv[3], "input") == 0 && strlen(argv[4]) == 4) {
+      unsigned value;
+      char tail;
+      if (sscanf(argv[4], "%4x%c", &value, &tail) == 1 && value <= UINT16_MAX &&
+          cec_command_valid_physical_address((uint16_t)value)) {
+        kind = CEC_COMMAND_INPUT;
+        address = (uint16_t)value;
+        valid = true;
+      }
+    }
+    if (!valid) {
+      cdc_printfln("@cec id=%lu state=rejected result=error", (unsigned long)id);
+      return 0;
+    }
+    if (!cec_command_submit(id, kind, address)) {
+      cdc_printfln("@cec id=%lu state=rejected result=busy", (unsigned long)id);
+      return 0;
+    }
+    cdc_printfln("@cec id=%lu state=queued", (unsigned long)id);
+    return 0;
+  }
+  return -1;
