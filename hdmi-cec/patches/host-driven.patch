diff --git a/src/cec-command-task.c b/src/cec-command-task.c
new file mode 100644
index 0000000..b8c8554
--- /dev/null
+++ b/src/cec-command-task.c
@@ -0,0 +1,69 @@
+#include "pico/stdlib.h"
+#include "cec-command.h"
+#include "cec-task.h"
+
+static cec_command_status_t command_status;
+static bool command_available;
+
+bool cec_command_submit(uint32_t id, cec_command_kind_t kind, uint16_t address) {
+  cec_command_frame_t frame;
+  if (id == 0 || !cec_command_encode(kind, address, &frame)) return false;
+  bool accepted = false;
+  taskENTER_CRITICAL();
+  if (!command_available && command_status.state != CEC_COMMAND_PENDING &&
+      command_status.state != CEC_COMMAND_QUEUED) {
+    command_status = (cec_command_status_t){.id = id, .kind = kind,
+      .physical_address = address, .state = CEC_COMMAND_QUEUED,
+      .result = CEC_COMMAND_ERROR};
+    command_available = true;
+    accepted = true;
+  }
+  taskEXIT_CRITICAL();
+  return accepted;
+}
+
+bool cec_command_snapshot(uint32_t id, cec_command_status_t *out) {
+  if (!out) return false;
+  bool found;
+  taskENTER_CRITICAL();
+  found = command_status.id == id && command_status.state != CEC_COMMAND_IDLE;
+  if (found) *out = command_status;
+  taskEXIT_CRITICAL();
+  return found;
+}
+
+uint16_t cec_get_physical_address(void) { return 0xffff; }
+uint8_t cec_get_logical_address(void) { return 4; }
+bool cec_send_msg(const cec_message_t *msg) { (void)msg; return false; }
+
+void cec_task(void *param) {
+  (void)param;
+  cec_frame_init();
+  for (;;) {
+    cec_command_status_t current = {0};
+    bool execute = false;
+    taskENTER_CRITICAL();
+    if (command_available) {
+      command_available = false;
+      command_status.state = CEC_COMMAND_PENDING;
+      current = command_status;
+      execute = true;
+    }
+    taskEXIT_CRITICAL();
+
+    if (execute) {
+      cec_command_frame_t frame;
+      cec_command_result_t result = CEC_COMMAND_ERROR;
+      if (cec_command_encode(current.kind, current.physical_address, &frame)) {
+        cec_message_t message = {.len = frame.len};
+        for (uint8_t i = 0; i < frame.len; ++i) message.data[i] = frame.data[i];
+        result = (cec_command_result_t)cec_frame_send_result(&message, 10000);
+      }
+      taskENTER_CRITICAL();
+      command_status.result = result;
+      command_status.state = CEC_COMMAND_DONE;
+      taskEXIT_CRITICAL();
+    }
+    vTaskDelay(pdMS_TO_TICKS(10));
+  }
+}
diff --git a/src/cec-command.c b/src/cec-command.c
new file mode 100644
index 0000000..54aa637
--- /dev/null
+++ b/src/cec-command.c
@@ -0,0 +1,58 @@
+#include "cec-command.h"
+
+bool cec_command_valid_physical_address(uint16_t address) {
+  bool zero_seen = false;
+  if (address == 0) return false;
+  for (int shift = 12; shift >= 0; shift -= 4) {
+    uint8_t nibble = (address >> shift) & 0x0f;
+    if (zero_seen && nibble != 0) return false;
+    if (nibble == 0) zero_seen = true;
+  }
+  return true;
+}
+
+bool cec_command_encode(cec_command_kind_t kind, uint16_t address, cec_command_frame_t *frame) {
+  if (!frame) return false;
+  *frame = (cec_command_frame_t){0};
+  switch (kind) {
+    case CEC_COMMAND_ON:
+      frame->data[0] = 0x40;
+      frame->data[1] = 0x04;
+      frame->len = 2;
+      return true;
+    case CEC_COMMAND_OFF:
+      frame->data[0] = 0x40;
+      frame->data[1] = 0x36;
+      frame->len = 2;
+      return true;
+    case CEC_COMMAND_INPUT:
+      if (!cec_command_valid_physical_address(address)) return false;
+      frame->data[0] = 0x4f;
+      frame->data[1] = 0x86;
+      frame->data[2] = address >> 8;
+      frame->data[3] = address;
+      frame->len = 4;
+      return true;
+  }
+  return false;
+}
+
+const char *cec_command_state_name(cec_command_state_t state) {
+  switch (state) {
+    case CEC_COMMAND_QUEUED: return "queued";
+    case CEC_COMMAND_PENDING: return "pending";
+    case CEC_COMMAND_DONE: return "done";
+    default: return "idle";
+  }
+}
+
+const char *cec_command_result_name(cec_command_result_t result) {
+  switch (result) {
+    case CEC_COMMAND_ACK: return "ack";
+    case CEC_COMMAND_NACK: return "nack";
+    case CEC_COMMAND_BUSY: return "busy";
+    case CEC_COMMAND_TIMEOUT: return "timeout";
+    case CEC_COMMAND_COLLISION: return "collision";
+    default: return "error";
+  }
+}
